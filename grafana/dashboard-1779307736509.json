      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Sobre",
          "description": "Data da Garantia Nesse Dashboard esta Baseada na data de ativacao. De acordo com a zte  sao 5 anos de garantia, baseada na nota fiscal.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "z5MeM1Tnk"
                      },
                      "spec": {
                        "dataset": "zabbix",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \n    h.host AS 'Host/Ip', \n    h.name AS 'Nome Visivel', \n    (SELECT t.value FROM history_str t JOIN items it ON t.itemid = it.itemid WHERE it.hostid = h.hostid AND it.key_ = 'enabledate' ORDER BY t.clock DESC LIMIT 1) AS 'Data de Ativação',\n    (SELECT t.value FROM history_str t JOIN items it ON t.itemid = it.itemid WHERE it.hostid = h.hostid AND it.key_ = 'garantia.calculada' ORDER BY t.clock DESC LIMIT 1) AS 'Garantia',\n    (SELECT t.value FROM history_uint t JOIN items it ON t.itemid = it.itemid WHERE it.hostid = h.hostid AND it.key_ = 'garantia.dias_restantes' ORDER BY t.clock DESC LIMIT 1) AS 'Dias Restantes',\n    (SELECT t.value FROM history_uint t JOIN items it ON t.itemid = it.itemid WHERE it.hostid = h.hostid AND it.key_ = 'serial' ORDER BY t.clock DESC LIMIT 1) AS 'Numero de Serie'\nFROM \n    hosts h\nLEFT JOIN \n    interface i ON h.hostid = i.hostid\nWHERE \n    h.name = '$HOSTNAME';",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [
                                {
                                  "name": "host",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            },
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "hosts"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.1+security-01",
            "spec": {
